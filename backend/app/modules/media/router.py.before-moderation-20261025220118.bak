"""V1 profile photo API: authenticated writes, validated canonical WebP and Redis rate limits."""
from __future__ import annotations
import os
import secrets
from pathlib import Path
from fastapi import APIRouter, Depends, File, HTTPException, UploadFile
from fastapi.responses import FileResponse
from sqlalchemy.orm import Session
from backend.app.core.database import get_db
from backend.app.models import EmployerProfile, User, WorkerProfile
from backend.app.modules.auth.router import current_user
from .security import MAX_BYTES, IDENT, owned_path, process_photo, PREFIX

router = APIRouter(prefix='/api/media', tags=['Profile photo'])

def _root() -> Path:
    return Path(os.getenv('MEDIA_ROOT', './data/media')).resolve()

def _profile(db: Session, user: User):
    if user.role == 'worker':
        return db.get(WorkerProfile, user.id)
    if user.role == 'employer':
        return db.get(EmployerProfile, user.id)
    raise HTTPException(403, 'Unsupported account role')

def _throttle(user: User, operation: str) -> None:
    """Redis sliding fixed window shared across workers; fail closed on outage."""
    import redis
    client = redis.Redis.from_url(os.getenv('MEDIA_REDIS_URL', os.getenv('REDIS_URL', 'redis://redis:6379/0')),
                                  socket_connect_timeout=1, socket_timeout=1)
    key = f'media:v1:{operation}:{user.id}'
    try:
        # Atomic INCR+initial expiry via Lua; 10 uploads/hour, 20 deletes/hour.
        script = '''local n=redis.call("INCR", KEYS[1]); if n==1 then redis.call("EXPIRE",KEYS[1],ARGV[1]) end; return n'''
        n = int(client.eval(script, 1, key, 3600))
    except redis.RedisError as exc:
        raise HTTPException(503, 'Upload protection temporarily unavailable') from exc
    if n > (10 if operation == 'upload' else 20):
        raise HTTPException(429, 'Too many photo changes; try again later', headers={'Retry-After':'3600'})

def _remove_old(path: Path | None) -> None:
    if path is not None:
        try:
            path.unlink(missing_ok=True)
        except OSError:
            # An orphan is safer than failing a committed replacement; follow up with cleanup.
            import logging
            logging.getLogger(__name__).warning('Could not remove old profile image')

@router.post('/profile-photo')
async def upload_profile_photo(photo: UploadFile = File(...), user: User = Depends(current_user), db: Session = Depends(get_db)):
    profile = _profile(db, user)
    if profile is None:
        raise HTTPException(409, 'Create your profile before uploading a photo')
    _throttle(user, 'upload')
    raw = await photo.read(MAX_BYTES + 1)
    declared_type = photo.content_type
    await photo.close()
    data = process_photo(raw, declared_type)
    storage = _root()
    try:
        storage.mkdir(parents=True, exist_ok=True, mode=0o700)
        ident = secrets.token_hex(16)
        path = storage / f'{ident}.webp'
        with path.open('xb') as stream:
            stream.write(data)
    except OSError as exc:
        raise HTTPException(503, 'Photo storage unavailable') from exc
    old_path = owned_path(storage, profile.photo_url)
    profile.photo_url = PREFIX + ident + '.webp'
    try:
        db.commit()
    except Exception:
        db.rollback()
        path.unlink(missing_ok=True)
        raise
    _remove_old(old_path)
    return {'photo_url': profile.photo_url}

@router.get('/profile-photos/{name}.webp')
def get_profile_photo(name: str):
    if not IDENT.fullmatch(name):
        raise HTTPException(404, 'Photo not found')
    path = _root() / f'{name}.webp'
    if not path.is_file():
        raise HTTPException(404, 'Photo not found')
    return FileResponse(path, media_type='image/webp', headers={
        'Cache-Control':'public, max-age=86400',
        'X-Content-Type-Options':'nosniff',
        'Content-Security-Policy':"default-src 'none'; sandbox",
    })

@router.delete('/profile-photo')
def delete_profile_photo(user: User = Depends(current_user), db: Session = Depends(get_db)):
    profile = _profile(db, user)
    if profile is None:
        raise HTTPException(404, 'Profile not found')
    _throttle(user, 'delete')
    old_path = owned_path(_root(), profile.photo_url)
    profile.photo_url = None
    try:
        db.commit()
    except Exception:
        db.rollback()
        raise
    _remove_old(old_path)
    return {'photo_url':None}
